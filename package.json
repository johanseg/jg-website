{
  "name": "digital-optimizer-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:johan": "npm run dev -w @digital-optimizer/johan",
    "dev:agency": "npm run dev -w @digital-optimizer/agency",
    "build": "npm run build:johan && npm run build:agency",
    "build:johan": "npm run build -w @digital-optimizer/johan",
    "build:agency": "npm run build -w @digital-optimizer/agency",
    "check": "npm run check -w @digital-optimizer/johan && npm run check -w @digital-optimizer/agency"
  }
}
